generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  GUARDIAN
  TUTOR
  ADMIN
}

enum Gender {
  MALE
  FEMALE
  ANY
}

enum TuitionType {
  HOME_TUTORING
  ONLINE_TUTORING
  GROUP_TUTORING
  PACKAGE_TUTORING
  SHADOW_TUTORING
}

enum JobStatus {
  PENDING_APPROVAL
  LIVE
  APPOINTED
  CANCELLED
}

enum ApplicationStatus {
  APPLIED
  SHORTLISTED
  DEMO_SCHEDULED
  APPOINTED
  REJECTED
  WITHDRAWN
}

enum PaymentStatus {
  UNPAID
  PAID
  REFUNDED
}

enum PaymentMethod {
  BKASH
  NAGAD
  ROCKET
  CARD
  BANK
}

enum VerificationLevel {
  UNVERIFIED
  BASIC_VERIFIED
  PREMIUM_VERIFIED
}

model User {
  id               String           @id @default(uuid())
  name             String
  phone            String           @unique
  email            String?          @unique
  passwordHash     String
  role             UserRole         @default(GUARDIAN)
  avatarUrl        String?
  isPhoneVerified  Boolean          @default(false)
  isActive         Boolean          @default(true)
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt

  guardianProfile  GuardianProfile?
  tutorProfile     TutorProfile?

  @@index([phone])
  @@index([email])
}

model GuardianProfile {
  id                 String    @id @default(uuid())
  userId             String    @unique
  user               User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  emergencyPhone     String?
  city               String    @default("Dhaka")
  location           String    // e.g. "Dhanmondi", "Mirpur 2", "Uttara"
  detailedAddress    String?
  notes              String?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  jobs               JobPost[]
  demoClasses        DemoClass[]
  confirmationLetters ConfirmationLetter[]
  reviewsGiven       Review[]
}

model TutorProfile {
  id                    String             @id @default(uuid())
  userId                String             @unique
  user                  User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  gender                Gender             @default(MALE)
  bio                   String?            @db.Text
  dateOfBirth           DateTime?
  bloodGroup            String?
  religion              String?
  nationalIdNumber      String?
  verificationLevel     VerificationLevel  @default(UNVERIFIED)
  isVerified            Boolean            @default(false)
  rating                Float              @default(5.0)
  totalReviews          Int                @default(0)
  tuitionsCompleted     Int                @default(0)
  expectedMinimumSalary Decimal            @default(5000.00) @db.Decimal(10, 2)
  availableFrom         DateTime?
  createdAt             DateTime           @default(now())
  updatedAt             DateTime           @updatedAt

  education             TutorEducation[]
  preferences           TutorPreference?
  documents             TutorDocument[]
  applications          JobApplication[]
  demoClasses           DemoClass[]
  confirmationLetters   ConfirmationLetter[]
  invoices              Invoice[]
  reviewsReceived       Review[]

  @@index([isVerified])
  @@index([rating])
}

model TutorEducation {
  id             String       @id @default(uuid())
  tutorProfileId String
  tutorProfile   TutorProfile @relation(fields: [tutorProfileId], references: [id], onDelete: Cascade)
  level          String       // "SSC", "HSC", "GRADUATION", "POST_GRADUATION"
  institution    String       // e.g. "BUET", "University of Dhaka", "Viqarunnisa Noon"
  curriculum     String?      // "Bangla Medium", "English Medium", "English Version", "Madrasa"
  department     String?      // e.g. "CSE", "Physics", "Science"
  gpa            Float?
  passingYear    Int
  isCurrent      Boolean      @default(false)
  createdAt      DateTime     @default(now())
}

model TutorPreference {
  id                    String       @id @default(uuid())
  tutorProfileId        String       @unique
  tutorProfile          TutorProfile @relation(fields: [tutorProfileId], references: [id], onDelete: Cascade)
  preferredCities       String[]     // ["Dhaka"]
  preferredLocations    String[]     // ["Dhanmondi", "Mohammadpur", "Lalmatia"]
  preferredCategories   String[]     // ["English Medium", "Bangla Medium"]
  preferredClasses      String[]     // ["Class 9", "Class 10", "O Level"]
  preferredSubjects     String[]     // ["Physics", "Higher Mathematics", "Chemistry"]
  availableDaysPerWeek  Int?         @default(4)
  preferredTutoringType TuitionType  @default(HOME_TUTORING)
  createdAt             DateTime     @default(now())
  updatedAt             DateTime     @updatedAt
}

model TutorDocument {
  id             String       @id @default(uuid())
  tutorProfileId String
  tutorProfile   TutorProfile @relation(fields: [tutorProfileId], references: [id], onDelete: Cascade)
  documentType   String       // "NID_FRONT", "NID_BACK", "STUDENT_ID", "TRANSCRIPT"
  fileUrl        String
  isVerified     Boolean      @default(false)
  uploadedAt     DateTime     @default(now())
}

model JobPost {
  id                  Int          @id @default(autoincrement()) // e.g. 243138 (Caretutors ID format)
  title               String       // "Need English Medium Tutor For Standard 3 Student-4 Days/Week"
  guardianId          String
  guardian            GuardianProfile @relation(fields: [guardianId], references: [id], onDelete: Cascade)
  tuitionType         TuitionType  @default(HOME_TUTORING)
  category            String       // "English Medium", "Bangla Medium", "Religious Studies"
  className           String       // "Standard 3", "HSC 2nd Year", "Class 8"
  subjects            String       // "Physics, Chemistry, Higher Maths" or "All Subjects"
  studentGender       Gender       @default(MALE)
  preferredTutorGender Gender      @default(ANY)
  tutoringDaysPerWeek Int          @default(3)
  tutoringTime        String?      // "Evening (After 6:00 PM)"
  noOfStudents        Int          @default(1)
  salary              Decimal      @db.Decimal(10, 2) // e.g. 7000.00
  country             String       @default("Bangladesh")
  city                String       @default("Dhaka")
  location            String       // "Mohammadpur", "Mirpur 2"
  detailedAddress     String?      // Hidden until confirmed
  latitude            Float?
  longitude           Float?
  otherRequirements   String?      @db.Text
  status              JobStatus    @default(PENDING_APPROVAL)
  postedDate          DateTime     @default(now())
  createdAt           DateTime     @default(now())
  updatedAt           DateTime     @updatedAt

  applications        JobApplication[]
  demoClasses         DemoClass[]
  confirmationLetter  ConfirmationLetter?

  @@index([city, location])
  @@index([category])
  @@index([status])
}

model JobApplication {
  id             String            @id @default(uuid())
  jobId          Int
  job            JobPost           @relation(fields: [jobId], references: [id], onDelete: Cascade)
  tutorId        String
  tutor          TutorProfile      @relation(fields: [tutorId], references: [id], onDelete: Cascade)
  expectedSalary Decimal?          @db.Decimal(10, 2)
  coverNote      String?           @db.Text
  status         ApplicationStatus @default(APPLIED)
  appliedAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt

  demoClasses    DemoClass[]

  @@unique([jobId, tutorId])
  @@index([status])
}

model DemoClass {
  id             String          @id @default(uuid())
  jobId          Int
  job            JobPost         @relation(fields: [jobId], references: [id], onDelete: Cascade)
  applicationId  String
  application    JobApplication  @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  tutorId        String
  tutor          TutorProfile    @relation(fields: [tutorId], references: [id], onDelete: Cascade)
  guardianId     String
  guardian       GuardianProfile @relation(fields: [guardianId], references: [id], onDelete: Cascade)
  scheduledDate  DateTime
  timeSlot       String          // e.g. "5:00 PM - 6:30 PM"
  status         String          @default("SCHEDULED") // "SCHEDULED", "COMPLETED", "CANCELLED"
  guardianNotes  String?
  tutorFeedback  String?
  createdAt      DateTime        @default(now())
}

model ConfirmationLetter {
  id                     String          @id @default(uuid()) // Official Contract Reference
  jobId                  Int             @unique
  job                    JobPost         @relation(fields: [jobId], references: [id], onDelete: Cascade)
  guardianId             String
  guardian               GuardianProfile @relation(fields: [guardianId], references: [id], onDelete: Cascade)
  tutorId                String
  tutor                  TutorProfile    @relation(fields: [tutorId], references: [id], onDelete: Cascade)
  monthlySalary          Decimal         @db.Decimal(10, 2)
  daysPerWeek            Int
  startDate              DateTime
  contractTerms          String          @db.Text
  platformChargeRate     Float           @default(55.0) // 55% for Home/Online, 35% for Package
  platformChargeAmount   Decimal         @db.Decimal(10, 2)
  paymentStatus          PaymentStatus   @default(UNPAID)
  dueDate                DateTime        // 7 days after issue
  issuedAt               DateTime        @default(now())
  updatedAt              DateTime        @updatedAt

  invoices               Invoice[]
}

model Invoice {
  id                   String             @id @default(uuid())
  confirmationLetterId String
  confirmationLetter   ConfirmationLetter @relation(fields: [confirmationLetterId], references: [id], onDelete: Cascade)
  tutorId              String
  tutor                TutorProfile       @relation(fields: [tutorId], references: [id], onDelete: Cascade)
  amount               Decimal            @db.Decimal(10, 2)
  paymentMethod        PaymentMethod?
  transactionId        String?            @unique
  status               PaymentStatus      @default(UNPAID)
  paidAt               DateTime?
  createdAt            DateTime           @default(now())
  updatedAt            DateTime           @updatedAt

  @@index([transactionId])
}

model Lead {
  id          String   @id @default(uuid())
  phone       String
  name        String?
  address     String?
  description String?  @db.Text
  source      String?  @default("web_direct")
  status      String   @default("NEW") // "NEW", "CONTACTED", "CONVERTED", "DROPPED"
  createdAt   DateTime @default(now())

  @@index([phone])
  @@index([status])
}

model Review {
  id           String          @id @default(uuid())
  tutorId      String
  tutor        TutorProfile    @relation(fields: [tutorId], references: [id], onDelete: Cascade)
  guardianId   String
  guardian     GuardianProfile @relation(fields: [guardianId], references: [id], onDelete: Cascade)
  rating       Int             @default(5) // 1 to 5
  reviewText   String?         @db.Text
  createdAt    DateTime        @default(now())

  @@index([tutorId])
}
